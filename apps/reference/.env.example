# Copy to .env. All values are optional. The dev server reads this file on
# startup; restart `vp run dev:reference` after editing it. Values already
# set in the environment win over the file.

# Externally reachable origin. Used to build the Google OAuth redirect URI.
# No trailing slash. Defaults to http://127.0.0.1:5174.
HOMESLATE_PUBLIC_BASE_URL=http://127.0.0.1:5174

# Google Calendar
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Commute routing
OPENROUTESERVICE_API_KEY=

# Stock quotes
FINNHUB_API_KEY=

# Home Assistant, when the API can reach it directly on the LAN.
# The usual origin includes port 8123.
HOMEASSISTANT_BASE_URL=
HOMEASSISTANT_TOKEN=

# Reach Home Assistant through a LAN agent instead of directly. When
# HOMESLATE_RELAY_TOKEN is set, the URL and token above are not used.
HOMESLATE_RELAY_TOKEN=
HOMESLATE_ACCOUNT_ID=

    "@homeslate/widgets": "^1.0.0",
    "@var-ui/core": "^0.1.0",
    "@var-ui/icons": "^0.1.0",
    "@var-ui/react": "^0.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@typestyles/vite": "^0.4.4",
    "@vitejs/plugin-react": "^5.1.1",

# Copy to .env and fill in. All values are optional except the base URL.
# Everything else degrades gracefully: no Google credentials means the
# calendar widgets stay empty, no OpenRouteService key disables the commute
# route, no Home Assistant values disable the thermostat widget.

# The externally reachable origin of this app. Must match the base of the
# redirect URI on your Google OAuth client, with no trailing slash.
HOMESLATE_PUBLIC_BASE_URL=http://homeslate.lan

# Google Calendar (see the self-hosting guide)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Commute routing
OPENROUTESERVICE_API_KEY=

# Home Assistant, when the API can reach it directly on the LAN
HOMEASSISTANT_BASE_URL=
HOMEASSISTANT_TOKEN=

# Copy to .env and fill in. compose.yaml reads this via the `env_file`
# directive is not set, so the values are interpolated by docker compose
# from the host environment — using a .env file works out of the box
# because compose auto-loads it from the project root.

# Externally reachable origin of this homeslate instance. Must match the
# Authorized redirect URI registered in Google Cloud Console byte-for-byte.
# Examples:
#   HOMESLATE_PUBLIC_BASE_URL=http://homeslate.lan
#   HOMESLATE_PUBLIC_BASE_URL=http://192.168.1.50:8080
HOMESLATE_PUBLIC_BASE_URL=

# Google OAuth credentials. Both are required for the calendar widget to
# sign in. If either is blank, the editor and kiosk still run, but
# calendar widgets stay empty.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional. If set, the commute widget can call openrouteservice.
# OPENROUTESERVICE_API_KEY=

# Optional. If both are set, the thermostat widget can read and control
# Home Assistant climate entities. Create a long-lived access token in your
# Home Assistant profile (bottom of the "Security" tab).
# HOMEASSISTANT_BASE_URL=http://homeassistant.local:8123
# HOMEASSISTANT_TOKEN=

# Optional. Reach Home Assistant from an API that is NOT on the home network
# (e.g. a VPS) by running @homeslate/agent on the LAN. Set the same shared
# secret and account here and on the agent, and reverse-proxy /agent to this
# API (see CONTAINER.md). Leave blank to use the direct credentials above.
# HOMESLATE_RELAY_TOKEN=
# HOMESLATE_ACCOUNT_ID=self-hosted

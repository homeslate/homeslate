{
  "name": "@homeslate/editor",
  "version": "0.1.2",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/homeslate/homeslate.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --tsconfig ../../tsconfig.app.json --config ../../tsup.config.ts",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@homeslate/display": "workspace:*",
    "@homeslate/schema": "workspace:*",
    "@homeslate/widgets": "workspace:*",
    "@mantine/core": "^8.3.10",
    "@tabler/icons-react": "^3.35.0",
    "uuid": "^13.0.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}

  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/homeslate/homeslate.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },

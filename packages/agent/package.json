{
  "name": "@homeslate/agent",
  "version": "0.1.1",
  "description": "LAN agent that connects a home network's Home Assistant to a hosted homeslate relay over an outbound WebSocket.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phthalo-dev/homeslate.git"
  },
  "bin": {
    "homeslate-agent": "./dist/bin.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@homeslate/server": "workspace:*",
    "@homeslate/widgets": "workspace:*"
  },
  "engines": {
    "node": ">=22.13"
  }
}
